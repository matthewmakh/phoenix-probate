# Phoenix Probate configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values, OR enter the keys in the
# app sidebar (it writes them here for you). Keep .env private — it holds
# secret API keys and is never committed to git.

# Azure Computer Vision (OCR) — reads text from the downloaded PDFs
AZ_ENDPOINT=https://<your-region>.api.cognitive.microsoft.com
AZ_KEY=<your-azure-key>

# OpenAI — turns the OCR text into the structured spreadsheet columns
OPENAI_API_KEY=<your-openai-key>
OPENAI_MODEL=gpt-4o-mini

# Optional: seconds to wait between cases (slows down to be gentle on the site)
# INTER_CASE_DELAY_SEC=2.0
