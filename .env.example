# Railway PostgreSQL Database URL
# This will be automatically set by Railway when you add a PostgreSQL plugin
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/probate_db

# For local development, you can use a local PostgreSQL database
# or connect to your Railway database for testing

# Flask settings (optional)
FLASK_DEBUG=false
PORT=5000

# Azure OCR (for scraper - not needed on Railway)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# OpenAI (for scraper - not needed on Railway)
OPENAI_API_KEY=
